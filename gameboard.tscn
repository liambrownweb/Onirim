[sub_resource type="GDScript" id="GDScript_kv177"]
script/source = "extends Control
const CardScene = preload(\"res://CardScene.tscn\")
var hand_array = []
var drawing_cards = false
var drop_target = null
@onready var game: Control = get_node(\"/root/Main/Game\")
@onready var DragLayer = get_tree().root.get_node(\"Main/DragLayer\")
@onready var discard = $TextureRect/DiscardPile
@onready var playrow = $TextureRect2/PlayRow

func _ready() -> void:
	pass

func _process(_delta: float) -> void:
	pass
	
func init_ui() -> void:
	populate_hand()

func populate_hand() -> void:
	drawing_cards = true
	for data in game.hand:
		var card = CardScene.instantiate()
		# initialize card (example properties — adapt to your Card.tscn API)
		if card.has_method(\"set_card_data\"):
			card.set_card_data(data)
		elif card.has_node(\"Sprite\") and data.texture:
			card.get_node(\"Sprite\").texture = load(data.texture)
		$PlayerHand.add_child(card)
		card.gameboard = self
	_update_hand_layout()
	drawing_cards = false
		
func _update_hand_layout():
	var hand_array = $PlayerHand.get_children()
	var n = hand_array.size()
	if n == 0:
		return
	var span_deg = 60.0
	var radius = 320.0
	var center = Vector2(0, 300)   # local center of the fan; adjust as needed
	for i in range(n):
		var t = 0.5 if n == 1 else float(i) / float(n - 1)
		var angle = lerp(-span_deg/2, span_deg/2, t)
		var a = deg_to_rad(angle)
		var offset = Vector2(sin(a), -cos(a)) * radius
		var card = hand_array[i]
		card.position = center + offset
		card.rotation = a * 0.7

func _update_playrow_layout():
	var playrow_array = $TextureRect2/PlayRow.get_children()
	var n = playrow_array.size()
	var center = Vector2(0, 0)
	if n == 0:
		return
	for i in range(n):
		var offset = Vector2(50 * i, 0)
		var card = playrow_array[i]
		card.position = center + offset
		card.rotation = 0
		card.scale = Vector2(0.7, 0.7)

func _on_player_hand_child_entered_tree(_node: Node) -> void:
	if drawing_cards: 
		return
	_update_hand_layout()

func _on_player_hand_child_exiting_tree(_node: Node) -> void:
	if drawing_cards:
		return
	_update_hand_layout()
	
func drop_card(card: CardScene.CardScene) -> void:
		# find drop target under mouse (example: a Control with \"PlayRow\" name)
	var mouse_pos = get_global_mouse_position()
	#var picked = get_viewport().gui_pick(mouse_pos)  # returns Control under point
	var picked = get_drop_target()
	DragLayer.remove_child(card)
	if picked == discard and game.can_discard(card):
		picked.add_child(card)
		game.discard(card)
	elif picked == playrow and game.can_play(card):
		picked.add_child(card)
		game.play(card)
	else:
		# return to original parent and animate back (instant here)
		card.position = card.original_rect_pos
		card.original_parent.add_child(card)
		card.original_parent.move_child(card, card.original_index)
	pass

func get_drop_target() -> Control:
	var mouse_pos = get_global_mouse_position()
	if discard.get_rect().has_point(mouse_pos):
		return discard
	elif playrow.get_rect().has_point(mouse_pos):
		return playrow
	else: 
		return null

func _on_discard_pile_mouse_entered() -> void:
	print(\"Discard pile entered\")
	drop_target = $TextureRect/DiscardPile

func _on_discard_pile_mouse_exited() -> void:
	drop_target = null

func _on_play_row_mouse_entered() -> void:
	print(\"Play row entered\")
	drop_target = $TextureRect2/PlayRow

func _on_play_row_mouse_exited() -> void:
	drop_target = null


func _on_play_row_gui_input(event: InputEvent) -> void:
	print(event)


func _on_play_row_child_entered_tree(node: Node) -> void:
	_update_playrow_layout()
"

