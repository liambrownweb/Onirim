[sub_resource type="GDScript" id="GDScript_8ked3"]
resource_name = "CardScene"
script/source = "extends Control
var dragging = false
var drag_offset = Vector2.ZERO
var original_parent = null
var original_index = -1
var original_rect_pos = Vector2.ZERO

@onready var DragLayer = get_tree().root.get_node(\"Main/DragLayer\") # adjust path
# Called when the node enters the scene tree for the first time.
func _ready() -> void:
	pass # Replace with function body.

# Called every frame. 'delta' is the elapsed time since the previous frame.
func _process(delta: float) -> void:
	pass
	
func _gui_input(event: InputEvent) -> void:
	if event is InputEventMouseButton and event.button_index == MOUSE_BUTTON_LEFT and event.pressed:
		var mouse = get_viewport().get_mouse_position()
		if get_global_rect().has_point(mouse):    # Control: Rect2 in global coords
			_start_drag(mouse)
		if event.button_index == MOUSE_BUTTON_LEFT and event.pressed:
			_start_drag(event.position)
		elif event.button_index == MOUSE_BUTTON_LEFT and not event.pressed and dragging:
			_end_drag()
	elif event is InputEventMouseMotion and dragging:
		global_position = get_global_mouse_position() - drag_offset	
		
func _start_drag(local_click_pos):
	dragging = true
	original_parent = get_parent()
	original_index = self.get_index()
	original_rect_pos = position
	drag_offset = local_click_pos
	# reparent to DragLayer while preserving global position
	var gpos = global_position
	original_parent.remove_child(self)
	DragLayer.add_child(self)
	global_position = gpos
	move_to_front()

func _end_drag():
	dragging = false
	# find drop target under mouse (example: a Control with \"PlayRow\" name)
	var mouse_pos = get_global_mouse_position()
	var root = get_tree().root
	var picked = root.gui_pick(mouse_pos)  # returns Control under point
	if picked and picked.is_in_group(\"play_row\"):
		# add to end of play row and adjust local position/layout
		var target = picked
		var local = target.to_local(mouse_pos)
		DragLayer.remove_child(self)
		target.add_child(self)
		position = local
		# call target layout update if needed
		if target.has_method(\"on_card_dropped\"):
			target.on_card_dropped(self)
	else:
		# return to original parent and animate back (instant here)
		DragLayer.remove_child(self)
		original_parent.add_child(self)
		original_parent.move_child(self, original_index)
		position = original_rect_pos

func _get_drag_data(at_position: Vector2) -> Variant:
	print(at_position)
	return at_position


func _on_mouse_entered() -> void:
	print (\"Mouse Entered!\")
"

